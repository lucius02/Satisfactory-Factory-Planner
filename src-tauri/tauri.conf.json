{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Satisfactory Factory Planner",
  "version": "../package.json",
  "identifier": "nl.fabrieksplanner.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Satisfactory Factory Planner",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Satisfactory productiecalculator met plattegrond",
    "category": "Utility",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlDMTQ3OEM2OUM0NzRFRkIKUldUN1RrZWN4bmdVblBVTzRKWHhZOGRXVXZXcmkwdWRWajNRcmdocE1MVngwMlM2YitiK3pxRXQK",
      "endpoints": [
        "https://github.com/lucius02/Satisfactory-Factory-Planner/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}